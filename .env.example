# Copy this file to .env and fill in real values. Never commit .env itself.

# Database connection (Phase 4+)
DB_ENGINE=postgresql        # postgresql | sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_analytics
DB_USER=your_username
DB_PASSWORD=your_password

# SQLite fallback (used if DB_ENGINE=sqlite)
SQLITE_PATH=data/processed/ecommerce_analytics.db
